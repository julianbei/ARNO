# Binaries
bin/

# Go build artifacts
*.test
*.out

# macOS
.DS_Store

# Local agent-harness state, not project configuration.
.claude/

# jade's own tool-usage log. .jade/commands.json IS meant to be committed —
# it is the repo's declared command vocabulary — but the telemetry log is
# local measurement data that would conflict on every pull.
.jade/telemetry.jsonl

# Conformance fixtures are prepared inside the container, not committed.
test/conformance/repos/*/node_modules/
test/conformance/repos/*/package-lock.json
test/conformance/repos/ruby/Gemfile.lock
test/conformance/repos/*/target/
