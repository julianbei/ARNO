{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.julianbei/arno",
  "title": "Arno",
  "description": "The IDE for agents: read by symbol, edit against a revision, validate with your own build, revert.",
  "repository": {
    "url": "https://github.com/julianbei/arno",
    "source": "github"
  },
  "websiteUrl": "https://github.com/julianbei/arno#trying-arno-a-guide-for-testers",
  "version": "0.0.12",
  "packages": [
    {
      "registryType": "oci",
      "identifier": "ghcr.io/julianbei/arno-mcp:v0.0.12",
      "transport": {
        "type": "stdio"
      },
      "runtimeArguments": [
        {
          "type": "named",
          "description": "Mount the repository Arno should work on at /workspace",
          "name": "--mount",
          "value": "type=bind,src={workspace},dst=/workspace",
          "isRequired": true,
          "variables": {
            "workspace": {
              "description": "Absolute path of the repository on the host",
              "format": "filepath",
              "isRequired": true
            }
          }
        }
      ]
    }
  ]
}
